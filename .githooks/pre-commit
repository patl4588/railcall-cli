#!/bin/bash
# Pre-commit hook — runs before every git commit in this repo.
#
# The intra-repo install.sh drift check that used to live here (comparing
# install.sh vs website-v2/public/install.sh within the old contrib repo)
# was removed when the CLI + website split into separate repos in 2026-07.
#
# Cross-repo drift protection — enforcing that:
#   railcall-cli/install.sh  ==  railcall-website/public/install.sh  ==  railcall-core/install.sh
# is now a GitHub Action responsibility (see .github/workflows/, TODO).
# A local pre-commit hook can't see files in a sibling repo, so this hook
# no longer has a check to run.
#
# The file is kept (empty pass-through) so `git config core.hooksPath .githooks`
# doesn't error, and so we have a natural home for future local checks.

exit 0
